# OutfitPilot API: server-only secrets. Copy to .env.local for local dev and
# set the same names in Vercel > Project > Settings > Environment Variables.
# NEVER put these values in the mobile app or in any EXPO_PUBLIC_* variable.

# Decart permanent API key (used only to mint short-lived client tokens).
DECART_API_KEY=

# OpenAI key and model for the AI Stylist. If either is empty, /api/style
# returns the rule-based fallback (source: "fallback").
OPENAI_API_KEY=
# Required, no default. Pick a model that supports Structured Outputs (json_schema).
OPENAI_MODEL=
# Optional. Default 0.3. Set to "off" if your model rejects the temperature parameter.
OPENAI_TEMPERATURE=

# Optional. Comma-separated browser origins allowed by CORS (only matters for
# Expo web / browsers; native apps do not send CORS requests).
# Empty = no CORS headers (browsers on other origins cannot read responses).
# Example for Expo web dev: CORS_ORIGINS=http://localhost:8081
CORS_ORIGINS=

# Optional. Max Decart tokens per minute for ALL clients together, per server
# instance (cost guard on top of the 6/min per-IP limit). Default 20.
TOKEN_GLOBAL_PER_MIN=

