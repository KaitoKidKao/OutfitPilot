{
  "expo": {
    "name": "OutfitPilot",
    "slug": "outfitpilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outfitpilot",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.outfitpilot.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.outfitpilot.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "OutfitPilot uses your camera only for the live virtual try-on. While a session runs, video goes straight to the AI try-on service. Nothing is recorded or saved.",
          "microphonePermission": "OutfitPilot does not use your microphone. The live try-on sends video only and no audio is recorded."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OutfitPilot lets you pick one garment photo to try on. Only the photo you choose is used.",
          "cameraPermission": "OutfitPilot uses your camera only for the live virtual try-on. While a session runs, video goes straight to the AI try-on service. Nothing is recorded or saved.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
