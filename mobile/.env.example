# Copy to .env and fill in. This is the ONLY variable the mobile app reads.
# EXPO_PUBLIC_* values are inlined into the JS bundle in plain text, so never put
# DECART_API_KEY, OPENAI_API_KEY or any other secret here. Secrets live in api/.
#
# Local API on your laptop: use the laptop's LAN IP (phone and laptop on the same
# Wi-Fi / hotspot). "localhost" does not work from a physical phone.
# Port: the local API (api/, `npm run dev`) listens on 8787 unless PORT is set.
# Plain http:// is accepted only in development builds; release builds need https://.
EXPO_PUBLIC_API_URL=http://<LAN-IP>:8787
